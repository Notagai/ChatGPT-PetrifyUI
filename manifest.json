{
  "manifest_version": 3,
  "name": "PetrifyUI | Sidebar",
  "short_name": "PetrifyUI",
  "description": "Visible pixel walnut grain with soft hover/selected highlights; native ChatGPT sidebar and menu controls.",
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "PetrifyUI sidebar settings",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "src/sidebar.js",
        "src/menus.js"
      ],
      "css": [
        "src/sidebar.css",
        "src/menus.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/walnut-tile.png",
        "assets/brand-mark.svg",
        "assets/pixel-wood.svg",
        "assets/walnut-grain.svg",
        "assets/paper-fiber.svg",
        "assets/walnut-grain-v2.svg",
        "assets/paper-fiber-v2.svg",
        "assets/walnut-wood-v3.svg"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ]
    }
  ]
}
