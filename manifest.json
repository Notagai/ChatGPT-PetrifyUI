{
  "manifest_version": 3,
  "name": "PetrifyUI | Sidebar",
  "short_name": "PetrifyUI",
  "description": "Experimental floating parchment layout with ChatGPT container fallback and visible ambient surfaces.",
  "version": "1.28.1",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "action": {
    "default_title": "PetrifyUI sidebar settings",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "src/sidebar.js",
        "src/composer.js",
        "src/stage.js"
      ],
      "css": [
        "src/sidebar.css",
        "src/global.css",
        "src/composer.css",
        "src/stage.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "src/menus.js"
      ],
      "css": [
        "src/menus.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/walnut-tile.png",
        "assets/brand-mark.svg",
        "assets/pixel-wood.svg",
        "assets/walnut-grain.svg",
        "assets/paper-fiber.svg",
        "assets/walnut-grain-v2.svg",
        "assets/paper-fiber-v2.svg",
        "assets/walnut-wood-v3.svg",
        "assets/composer/paper-grain-geekify.svg",
        "assets/composer/paper-torn-top.svg",
        "assets/composer/paper-torn-bottom.svg",
        "assets/stage/study-ambient.svg"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
